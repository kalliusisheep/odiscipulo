ortinas do tabernaculo."},{"chapter":26,"verse":15,"title":"As taboas do tabernaculo."},{"chapter":26,"verse":31,"title":"O véu do tabernaculo."},{"chapter":27,"verse":1,"title":"O altar dos holocaustos."},{"chapter":27,"verse":9,"title":"O pateo do tabernaculo."},{"chapter":27,"verse":20,"title":"O azeite puro."},{"chapter":28,"verse":1,"title":"Deus escolhe Aarão e seus filhos para sacerdotes."},{"chapter":28,"verse":4,"title":"As vestes sacerdotaes."},{"chapter":28,"verse":30,"title":"Urim e Thummim."},{"chapter":28,"verse":36,"title":"A lamina de oiro puro."},{"chapter":29,"verse":1,"title":"O sacrificio e as ceremonias da consagração."},{"chapter":30,"verse":1,"title":"O altar do incenso."},{"chapter":30,"verse":12,"title":"O resgate da alma."},{"chapter":30,"verse":17,"title":"A pia de cobre."},{"chapter":30,"verse":22,"title":"O azeite da sancta uncção."},{"chapter":30,"verse":34,"title":"O incenso sancto."},{"chapter":31,"verse":1,"title":"Os artifices da obra do tabernaculo."},{"chapter":31,"verse":12,"title":"O sabbado sancto e as duas taboas do testemunho."},{"chapter":32,"verse":1,"title":"O bezerro de oiro."},{"chapter":32,"verse":19,"title":"Moysés quebra as taboas do testemunho."},{"chapter":32,"verse":25,"title":"Moysés manda matar os idolatras."},{"chapter":32,"verse":30,"title":"Moysés intercede pelo povo."},{"chapter":33,"verse":1,"title":"Deus não irá no meio do povo mas enviará um anjo."},{"chapter":33,"verse":12,"title":"Moysés roga a Deus a Sua presença."},{"chapter":33,"verse":18,"title":"Moysés roga a Deus lhe mostre a sua gloria."},{"chapter":34,"verse":1,"title":"As novas taboas dos dez mandamentos."},{"chapter":34,"verse":10,"title":"Deus faz um pacto."},{"chapter":34,"verse":29,"title":"O rosto de Moysés resplandece."},{"chapter":35,"verse":1,"title":"O sabbado e as offertas para o tabernaculo."},{"chapter":35,"verse":20,"title":"A promptidão do povo em trazer offertas."},{"chapter":35,"verse":30,"title":"Deus chama Bezaleel e Aholiab."}