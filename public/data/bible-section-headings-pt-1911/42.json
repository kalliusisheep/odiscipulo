ulheres que serviam a Jesus com os seus bens."},{"chapter":8,"verse":4,"title":"A parabola do semeador."},{"chapter":8,"verse":16,"title":"A parabola da candeia."},{"chapter":8,"verse":19,"title":"A familia de Jesus."},{"chapter":8,"verse":22,"title":"Jesus apazigua a tempestade."},{"chapter":8,"verse":26,"title":"O endemoninhado gadareno."},{"chapter":8,"verse":40,"title":"A filha de Jairo: a mulher que tinha um fluxo de sangue."},{"chapter":9,"verse":1,"title":"A missão dos doze."},{"chapter":9,"verse":7,"title":"Herodes o tetrarcha e João Baptista."},{"chapter":9,"verse":10,"title":"A primeira multiplicação dos pães."},{"chapter":9,"verse":18,"title":"A confissão de Pedro."},{"chapter":9,"verse":23,"title":"Cada um deve levar a sua cruz."},{"chapter":9,"verse":28,"title":"A transfiguração."},{"chapter":9,"verse":37,"title":"Cura d’um joven lunatico."},{"chapter":9,"verse":46,"title":"O maior no reino dos céus."},{"chapter":9,"verse":49,"title":"Quem não é contra nós é por nós."},{"chapter":9,"verse":51,"title":"Os samaritanos não recebem a Jesus."},{"chapter":9,"verse":57,"title":"Ácerca dos que seguem a Jesus."},{"chapter":10,"verse":1,"title":"A missão dos setenta discipulos."},{"chapter":10,"verse":25,"title":"A parabola do bom samaritano."},{"chapter":10,"verse":38,"title":"Martha e Maria."},{"chapter":11,"verse":1,"title":"A oração dominical."},{"chapter":11,"verse":5,"title":"Parabola do amigo importuno."},{"chapter":11,"verse":14,"title":"A blasphemia dos phariseos."},{"chapter":11,"verse":29,"title":"O signal do propheta Jonas."},{"chapter":11,"verse":33,"title":"A candeia do corpo."},{"chapter":11,"verse":37,"title":"Jesus censura os phariseos e os escribas."},{"chapter":12,"verse":4,"title":"Não devemos temer os homens."},{"chapter":12,"verse":13,"title":"A parabola do rico louco."},{"chapter":12,"verse":22,"title":"Solicitude pela nossa vida."},{"chapter":12,"verse":35,"title":"Parabola do servo vigilante."},{"chapter":12,"verse":49,"title":"Jesus traz